{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 Rock（CMake 目标）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
